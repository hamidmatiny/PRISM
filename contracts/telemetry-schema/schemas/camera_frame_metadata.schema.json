{
  "additionalProperties": false,
  "description": "Metadata for a captured fleet camera frame (imagery lives at storage_uri).",
  "properties": {
    "asset_id": {
      "pattern": "^PRISM-AST-\\d{3}$",
      "title": "Asset Id",
      "type": "string"
    },
    "capture_exposure_ms": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 60000.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Exposure Ms"
    },
    "content_type": {
      "default": "image/jpeg",
      "pattern": "^image/(jpeg|png|webp)$",
      "title": "Content Type",
      "type": "string"
    },
    "device_id": {
      "description": "Camera device id.",
      "pattern": "^PRISM-DEV-\\d{3}$",
      "title": "Device Id",
      "type": "string"
    },
    "event_type": {
      "default": "camera_frame",
      "pattern": "^camera_frame$",
      "title": "Event Type",
      "type": "string"
    },
    "frame_id": {
      "pattern": "^frm_[0-9a-f]{12}$",
      "title": "Frame Id",
      "type": "string"
    },
    "height_px": {
      "maximum": 16384,
      "minimum": 1,
      "title": "Height Px",
      "type": "integer"
    },
    "scenario_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stable scenario run id when synthetic_scenario is true.",
      "title": "Scenario Id"
    },
    "scenario_outcome": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional scenario outcome tag (e.g. cv_low_confidence).",
      "title": "Scenario Outcome"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "storage_uri": {
      "description": "Object URI for the frame bytes (s3:// or file://).",
      "minLength": 1,
      "title": "Storage Uri",
      "type": "string"
    },
    "synthetic_scenario": {
      "default": false,
      "description": "True when emitted by scenario-engine (ADR-005); never live fleet.",
      "title": "Synthetic Scenario",
      "type": "boolean"
    },
    "timestamp": {
      "description": "UTC capture time (timezone-aware).",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "width_px": {
      "maximum": 16384,
      "minimum": 1,
      "title": "Width Px",
      "type": "integer"
    }
  },
  "required": [
    "asset_id",
    "device_id",
    "frame_id",
    "timestamp",
    "storage_uri",
    "width_px",
    "height_px"
  ],
  "title": "CameraFrameMetadata",
  "type": "object"
}
