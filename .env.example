# PRISM local development — copy to .env. No real cloud credentials required
# for `docker compose up` (ADR-001). Cloud credentials are optional overlays.

PRISM_ENV=local

# Host port range: 9100–9199 (avoids Argus / Vulcan collisions on shared laptops)
PRISM_CONTROL_PLANE_PORT=9100
PRISM_COCKPIT_PORT=9101
PRISM_CV_SERVICE_PORT=9102
PRISM_ACTIVATION_GATEWAY_PORT=9103
PRISM_AI_COPILOT_PORT=9104
PRISM_INGESTION_PORT=9105

# Ingestion (Phase 1) — file backend needs no AWS credentials
PRISM_INGEST_BACKEND=file
PRISM_DATA_ROOT=.data
PRISM_EMIT_RATE=2
PRISM_FAILURE_RATE=0.05
PRISM_DURATION_SECONDS=0
PRISM_ASSET_IDS=PRISM-AST-001,PRISM-AST-002,PRISM-AST-003
PRISM_KINESIS_STREAM=prism-fleet-events
PRISM_SIM_SEED=42

# Optional LocalStack (compose profile: localstack)
LOCALSTACK_ENDPOINT=http://localhost:4566
DUCKDB_PATH=.data/prism.duckdb

# Lakehouse / dbt (Phase 2)
PRISM_LAKEHOUSE_ROOT=.data/lakehouse
# JAVA_HOME=/opt/homebrew/opt/openjdk@21

# CV service (Phase 3) — CPU ONNX only (ADR-001)
PRISM_CV_SERVICE_PORT=9102
PRISM_CV_CONFIDENCE_THRESHOLD=0.55
PRISM_CV_MODEL_PATH=cv-service/models/yolo_fleet_defects_tiny.onnx

# Activation gateway (Phase 4) — mock warehouses only in local/CI (ADR-001 / ADR-002)
PRISM_ACTIVATION_GATEWAY_PORT=9103
PRISM_ACTIVATION_MODE=mock
PRISM_MOCK_REDSHIFT_URL=http://127.0.0.1:9110
PRISM_MOCK_SNOWFLAKE_URL=http://127.0.0.1:9111
PRISM_ACTIVATION_FIXTURE_GOLD=activation-gateway/fixtures/gold

# Leave unset locally. Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DATABRICKS_HOST=
# SNOWFLAKE_ACCOUNT=
# REDSHIFT_WORKGROUP=
