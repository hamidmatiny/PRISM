# PRISM local development — copy to .env. No real cloud credentials required
# for `docker compose up` (ADR-001). Cloud credentials are optional overlays.

PRISM_ENV=local

# Host port range: 9100–9199 (avoids Argus / Vulcan collisions on shared laptops)
PRISM_CONTROL_PLANE_PORT=9100
PRISM_COCKPIT_PORT=9101
PRISM_CV_SERVICE_PORT=9102
PRISM_ACTIVATION_GATEWAY_PORT=9103
PRISM_AI_COPILOT_PORT=9104
PRISM_INGESTION_PORT=9105

# Local warehouse / object-store emulators (Phase 1+)
LOCALSTACK_ENDPOINT=http://localhost:4566
DUCKDB_PATH=.data/prism.duckdb

# Leave unset locally. Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DATABRICKS_HOST=
# SNOWFLAKE_ACCOUNT=
# REDSHIFT_WORKGROUP=
