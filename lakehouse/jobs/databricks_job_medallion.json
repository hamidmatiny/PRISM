{
  "name": "prism-medallion-bronze-silver-gold",
  "description": "PRISM Phase 2 medallion job. Validate-only in CI; apply manually (ADR-001).",
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_medallion",
      "description": "Execute bronze→silver→gold via prism_lakehouse entrypoint",
      "spark_python_task": {
        "python_file": "lakehouse/src/prism_lakehouse/__main__.py",
        "parameters": [
          "--bronze-root",
          "/Volumes/prism/bronze/raw",
          "--warehouse-root",
          "/Volumes/prism/warehouse"
        ]
      },
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        }
      },
      "libraries": [
        {
          "whl": "dbfs:/FileStore/prism/prism_lakehouse-0.1.0-py3-none-any.whl"
        }
      ]
    }
  ],
  "tags": {
    "project": "prism",
    "phase": "2",
    "cost_safety": "manual-apply-only"
  }
}
